<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 本体と同じ理由。OpenCvSharp のネイティブ DLL は x64 のみ -->
    <PlatformTarget>x64</PlatformTarget>

    <!--
      ViewModel を直接つついて検証するため WPF が要る。
      プレビュー生成は BitmapSource を返し、ダイアログの検証は
      DispatcherTimer を回すので、UI の型から切り離せない。
    -->
    <UseWPF>true</UseWPF>

    <!-- 検証用なのでドキュメントコメントの強制はしない -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Soroe\Soroe.csproj" />
  </ItemGroup>

</Project>
