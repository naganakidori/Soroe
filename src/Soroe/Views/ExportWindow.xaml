<Window x:Class="Soroe.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Soroe.Views.Controls"
        xmlns:converters="clr-namespace:Soroe.Views.Converters"
        xmlns:models="clr-namespace:Soroe.Models"
        xmlns:vm="clr-namespace:Soroe.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ExportDialogViewModel}"
        Title="書き出し"
        Height="500"
        MinHeight="480"
        Width="620"
        MinWidth="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Closing="OnClosing">
    <!--
        横に広げられるようにしている。出力パスが長いと 1 行に収まらないため。
        SizeToContent は使わない。WrapPanel の折り返しで高さが動く一方、
        縦のリサイズだけ効かないウィンドウになって挙動が不自然になる。
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:WidthFractionConverter x:Key="WidthFraction" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 失敗一覧。出たときだけ場所を取り、余りをここが受け取る -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 出力先 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="出力先:" VerticalAlignment="Center" Margin="0,0,8,0" />

            <TextBox Grid.Column="1"
                     VerticalContentAlignment="Center"
                     Text="{Binding Output.Folder, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Content="参照"
                    Margin="8,0,0,0"
                    Padding="14,4"
                    Command="{Binding SelectOutputFolderCommand}" />
        </Grid>

        <!-- 形式と品質。狭いときは折り返す -->
        <WrapPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="形式:" VerticalAlignment="Center" Margin="0,0,8,4" />

            <ComboBox MinWidth="168"
                      Margin="0,0,0,4"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding ExportFormats}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Format"
                      SelectedValue="{Binding Output.Format}" />

            <StackPanel Orientation="Horizontal"
                        Margin="20,0,0,4"
                        Visibility="{Binding ShowJpegQuality, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="JPEG 品質" VerticalAlignment="Center" Margin="0,0,6,0" />
                <controls:NumericSpinner VerticalAlignment="Center"
                                         Minimum="{x:Static models:ExportSettings.MinQuality}"
                                         Maximum="{x:Static models:ExportSettings.MaxQuality}"
                                         Step="5"
                                         Value="{Binding Output.JpegQuality}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="20,0,0,4"
                        Visibility="{Binding ShowWebPQuality, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="WebP 品質" VerticalAlignment="Center" Margin="0,0,6,0" />

                <!-- 可逆のときは品質が効かないので触れないようにする -->
                <controls:NumericSpinner VerticalAlignment="Center"
                                         Minimum="{x:Static models:ExportSettings.MinWebPQuality}"
                                         Maximum="{x:Static models:ExportSettings.MaxQuality}"
                                         Step="5"
                                         Value="{Binding Output.WebPQuality}">
                    <controls:NumericSpinner.Style>
                        <Style TargetType="controls:NumericSpinner">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Output.WebPLossless}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:NumericSpinner.Style>
                </controls:NumericSpinner>

                <CheckBox Content="可逆（ファイルサイズは大きくなります）"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding Output.WebPLossless}" />
            </StackPanel>
        </WrapPanel>

        <StackPanel Grid.Row="2">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExporting}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="透過は白で塗り潰されます"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Opacity="0.6" />

            <!-- 出力ファイル名。選んだ方式の入力欄だけを出す -->
            <WrapPanel Margin="0,12,0,0">
                <TextBlock Text="ファイル名:" VerticalAlignment="Center" Margin="0,0,8,4" />

                <ComboBox MinWidth="168"
                          Margin="0,0,0,4"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding NamingChoices}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Naming"
                          SelectedValue="{Binding Output.Naming}" />

                <StackPanel Orientation="Horizontal"
                            Margin="20,0,0,4"
                            Visibility="{Binding ShowPrefixSuffix, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="前" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="90"
                             VerticalContentAlignment="Center"
                             Text="{Binding Output.Prefix, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="後" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox Width="90"
                             VerticalContentAlignment="Center"
                             Text="{Binding Output.Suffix, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="20,0,0,4"
                            Visibility="{Binding ShowSequence, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="ベース名" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="120"
                             VerticalContentAlignment="Center"
                             Text="{Binding Output.SequenceBaseName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </WrapPanel>

            <TextBlock Text="&#x5c; / : * ? &quot; &lt; &gt; | は使えません"
                       Margin="0,2,0,0"
                       FontSize="11"
                       Opacity="0.6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPrefixSuffix}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowSequence}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <CheckBox Content="同名のファイルを上書きする"
                      Margin="0,12,0,0"
                      IsChecked="{Binding Output.Overwrite}" />

            <TextBlock Text="同名のファイルがある場合は別名で保存します"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Opacity="0.6"
                       Visibility="{Binding ShowRenameNotice, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!--
            実行前の最後の確認と、実行後の結果。設定・実行・進捗・結果をこの窓で完結させる。
            このブロックは内容ぶんだけの高さにする。余りは下の失敗一覧が受け取る。
        -->
        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="12,10"
                VerticalAlignment="Top"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    見積もりと結果は排他にする。見積もりは「今の設定でもう一度押したら
                    こうなる」という予告であって、直前の実行結果ではない。
                    並べると結果の報告と読み違える。
                -->
                <StackPanel Grid.Row="0"
                            Visibility="{Binding ShowEstimate, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding OutputPathPreview}"
                               ToolTip="{Binding OutputPathTooltip}"
                               TextTrimming="CharacterEllipsis" />

                    <!--
                        上書きの件数。ここが原則 2（原本を絶対に破壊しない）に対する
                        最後の確認になるので、警告色で目立たせる
                    -->
                    <TextBlock Margin="0,4,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverwriteCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="うち" />
                        <Run Text="{Binding OverwriteCount, Mode=OneWay}" />
                        <Run Text="件を上書きします" />
                    </TextBlock>

                    <!-- 全件がスキップされる設定。実行ボタンも無効になる -->
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding BlockingWarning}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BlockingWarning}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 押した時点で件数が変わっていた場合 -->
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding RecheckNotice}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecheckNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!--
                    件数とファイル名はバーの上に置く。横に並べると文字数でバーの幅が
                    変わり、進捗が戻ったように見えてしまう。
                -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Grid x:Name="ExportProgressLine" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Margin="0,0,10,0">
                            <Run Text="{Binding ExportCompleted, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding ExportTotal, Mode=OneWay}" />
                        </TextBlock>

                        <!--
                            MaxWidth は TextBlock 側に付ける。ColumnDefinition の MaxWidth は
                            測定を制限しないため、TextTrimming が働かず単に切れてしまう。
                            固定値にすると窓を広げても省略が解けないので、行の幅に対する割合で決める。
                        -->
                        <TextBlock Grid.Column="1"
                                   MaxWidth="{Binding ActualWidth, ElementName=ExportProgressLine,
                                              Converter={StaticResource WidthFraction}, ConverterParameter=0.38}"
                                   Text="{Binding ExportingSourceName}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="2" Text="  →  ">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExportingOutputName}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="3"
                                   MaxWidth="{Binding ActualWidth, ElementName=ExportProgressLine,
                                              Converter={StaticResource WidthFraction}, ConverterParameter=0.38}"
                                   Text="{Binding ExportingOutputName}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="4" Text="{Binding ExportingOutputExtension}" />
                    </Grid>

                    <ProgressBar Height="6"
                                 Minimum="0"
                                 Maximum="{Binding ExportTotal}"
                                 Value="{Binding ExportCompleted, Mode=OneWay}" />
                </StackPanel>

                <!-- 完了後の結果。閉じるまで残す -->
                <TextBlock Grid.Row="2"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding ResultMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </Grid>
        </Border>

        <!--
            失敗一覧だけを伸縮する行に置く。大半の実行では失敗が無いので、
            常に空き領域を予約しておくと無駄になる。
        -->
        <Grid Grid.Row="4" Margin="0,10,0,0" MinHeight="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ExportFailures.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ExportFailures}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 画面には日本語の要約しか出さないので、原文はここから取り出せるようにする -->
            <Button Grid.Row="1"
                    Content="詳細をコピー"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0"
                    Padding="10,3"
                    Click="OnCopyFailures" />
        </Grid>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <!--
                「実行」と「キャンセル」は同じ位置で入れ替える。常にボタンは 2 つになり、
                いま押せる操作だけが見える。
            -->
            <Grid>
                <Button Content="実行"
                        IsDefault="True"
                        MinWidth="96"
                        Padding="16,6"
                        Command="{Binding RunCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 本体が触れない間、止める手段はこれだけになる -->
                <Button Content="キャンセル"
                        MinWidth="96"
                        Padding="16,6"
                        Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 破棄ではなく「実行しないで閉じる」。設定はそのまま残る -->
            <Button Content="閉じる"
                    IsCancel="True"
                    MinWidth="96"
                    Margin="10,0,0,0"
                    Padding="16,6" />
        </StackPanel>
    </Grid>
</Window>
