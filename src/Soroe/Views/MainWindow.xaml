<Window x:Class="Soroe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Soroe.Views.Controls"
        xmlns:converters="clr-namespace:Soroe.Views.Converters"
        xmlns:models="clr-namespace:Soroe.Models"
        xmlns:vm="clr-namespace:Soroe.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Soroe"
        Height="990"
        Width="1100"
        MinHeight="600"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:FractionConverter x:Key="WidthFraction" Minimum="80" />

        <!--
            調整パネルの高さの上限。プレビューと縦を分け合わせるために、
            固定値ではなく右側の列の高さに対する割合で決める。
            下限は 140（見出し + 2 行程度）。ここを下回るくらい窓が低いときは、
            プレビューを削ってでも調整パネルを見せる。

            Reserve はプレビューに必ず残す高さ。割合を上げた効きは窓が低いときに
            集中するため（背の高い窓ではパネルが中身なりの高さで止まる）、
            これが無いと最小サイズでプレビューが潰れる。実測（DPI 150%・最小サイズ
            720x600）で、割合 0.55 のときのプレビューは約 179 だったが、0.70 では
            約 119 まで縮んだ。160 はその手前に置いてある。
        -->
        <converters:FractionConverter x:Key="PanelHeightFraction" Minimum="140" Reserve="160" />

        <!-- 調整パネルの分類見出し。3 分類で共通に使う -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- 調整項目 1 行分の並び。項目名 / スライダー / 数値入力 -->
        <Style x:Key="AdjustmentRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!--
            調整項目のスライダーに共通の振る舞い。項目が増えたらこれを適用するだけでよい。
            IsMoveToPointEnabled は、目盛りの上を押したときにその位置へつまみを飛ばす。
            既定は 1 目盛りずつの移動で、シークバーの挙動と違って戸惑うため。
            ホイールでの増減は、つまみを狙わずに 1 ずつ詰めるための補助。
        -->
        <!--
            BasedOn を必ず付けること。省略すると Fluent テーマの暗黙スタイルが
            適用されなくなり、既定のスライダーの見た目に戻ってしまう。
        -->
        <Style x:Key="AdjustmentSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <EventSetter Event="PreviewMouseWheel" Handler="OnSliderMouseWheel" />
        </Style>
    </Window.Resources>

    <!-- ウィンドウ全体でドロップを受ける。落とす場所を狙わせないほうが迷わない -->
    <Grid Margin="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 操作行 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="フォルダから追加"
                        Command="{Binding AddFolderCommand}"
                        Padding="14,6" />
                <Button Content="クリア"
                        Command="{Binding ClearCommand}"
                        Margin="8,0,0,0"
                        Padding="14,6" />
            </StackPanel>
            <TextBlock Text="{Binding Files.Count, StringFormat={}{0} 件}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- 左: ファイルリスト / 右: プレビュー -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListBox ItemsSource="{Binding Files}"
                             SelectedItem="{Binding SelectedFile}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="4"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}"
                                           ToolTip="{Binding FullPath}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="ここに画像を&#x0a;ドロップ"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Opacity="0.6"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <!-- 空のときだけ案内を出す -->
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- 上がプレビュー、下が調整パネル -->
            <Grid Grid.Column="2" x:Name="PreviewAndPanel">
                <Grid.RowDefinitions>
                    <!--
                        プレビュー側に MinHeight を置かないこと。Auto 行は場所が足りなくても
                        縮まないため、MinHeight と競合すると合計が親をはみ出して下が切れる。
                        プレビューを縮ませるほうが、調整パネルが見えなくなるより分かりやすい。
                    -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               StretchDirection="DownOnly"
                               Margin="12" />

                        <TextBlock Text="プレビュー"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            プレビューは枠に合わせて表示されるため、リサイズしても見た目が
                            ほとんど変わらない。効果が分かるよう寸法を数値で示す。
                        -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding PreviewSizeText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Opacity="0.75" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="14,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <!-- 書き出し中は触らせない。開始時点の設定で処理するため、途中で変えても効かない -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!--
                        項目が増えても縦に伸び続けないよう上限を設けて中でスクロールさせる。
                        ただし固定値にはしない。固定値だと項目を足すたびに数値を測って
                        上げ直す必要があり、気づかなければ既定サイズでも中身が切れる。
                        実際 2 項目のときの 220 が、4 項目では足りなくなっていた。

                        右側の列（プレビュー + 調整パネル）の高さに対する割合で決める。
                        こうすると、項目が少ないうちは中身なりの高さで収まり、
                        増えれば頭打ちになって自然にスクロールが出る。

                        この割合は「上限」であって「取り分」ではない。行は Auto なので、
                        パネルは中身が必要とする高さしか取らず、余りはプレビューへ行く。
                        実測（DPI 150%・窓 1000x1000）で、割合 0.75 のときの見えている高さは
                        0.75 x 798.7 = 599 ではなく、中身と同じ高さで頭打ちになった。
                        つまり割合を上げても、パネルが実際に必要とするまでプレビューは縮まない。
                        縮むのは中身が収まりきらない低い窓のときだけ。

                        0.75 は元々「既定サイズで 9 項目が収まる下限」として決めた値。
                        グレースケールと二値化を UI から外して中身が 583.0 から 467.7 になり、
                        既定サイズで必要な割合は 0.593 まで下がったので、現在は緩い。
                        それでも下げないのは、下げても見え方が変わらないため。実測で
                        0.60 / 0.65 / 0.75 のいずれでも、既定サイズ（中身が収まるので割合が効かない）と
                        最小サイズ（Reserve が先に効く）での結果は 1px も違わない。
                        差が出るのは 1080p@150% 相当だけで、そこは 0.75 が最もパネルを見せる。
                        詳細は docs/design.md「既定ウィンドウサイズ」。
                    -->
                    <ScrollViewer MaxHeight="{Binding ActualHeight, ElementName=PreviewAndPanel,
                                              Converter={StaticResource PanelHeightFraction},
                                              ConverterParameter=0.75}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <!--
                        右に余白を空ける。Fluent のスクロールバーは内容の上に重ねて
                        表示されるため、空けないと数値入力欄のスピンボタンに重なり、
                        押そうとしてスクロールバーを掴む誤操作が起きる。
                        スクロールバーの有無で幅を変えない。変えると、項目を増やして
                        スクロールが出た瞬間に中身が横へずれる。
                    -->
                    <StackPanel Margin="0,0,16,0">
                        <!--
                            調整パネルは 3 分類で区切る（docs/design.md「調整項目」）。
                              1. キャンバスを変える … 回転、リサイズ
                              2. 画素値を変える     … 明るさ、コントラスト、彩度、シャープ
                                 （グレースケールと二値化は処理だけ残し、UI には出していない）
                              3. 描き足す           … 枠線
                        -->
                        <TextBlock Text="キャンバスを変える" Style="{StaticResource SectionHeaderStyle}" />

                        <!-- 窓が狭いときは折り返す。横一列に固定すると右端が切れて読めなくなる -->
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox Content="回転"
                                      MinWidth="92"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.Rotation.Enabled}" />

                            <!--
                                90 度単位のみ。任意角度は入れない（理由は RotationAngle）。
                                「回転しない」はチェックボックスが持つので候補に入れない
                            -->
                            <ComboBox MinWidth="140"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding RotationChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Angle"
                                      SelectedValue="{Binding Settings.Rotation.Angle}"
                                      IsEnabled="{Binding Settings.Rotation.Enabled}" />

                            <TextBlock Text="回す"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox Content="リサイズ"
                                      MinWidth="92"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.Resize.Enabled}" />

                            <TextBlock Text="長辺を"
                                       Margin="8,0,6,0"
                                       VerticalAlignment="Center" />

                            <!-- よく使う値を用途つきで並べる。自由入力もここから選ぶ -->
                            <ComboBox MinWidth="196"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding ResizePresets}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedResizePreset}"
                                      IsEnabled="{Binding Settings.Resize.Enabled}" />

                            <controls:NumericSpinner Margin="8,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Minimum="{x:Static models:ResizeOption.MinValue}"
                                                     Maximum="{x:Static models:ResizeOption.MaxValue}"
                                                     Step="10"
                                                     Value="{Binding Settings.Resize.LongestEdge}"
                                                     IsEnabled="{Binding Settings.Resize.Enabled}">
                                <controls:NumericSpinner.Style>
                                    <Style TargetType="controls:NumericSpinner">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- 自由入力を選んだときだけ出す。常に両方出すと入力先が二つに見える -->
                                            <DataTrigger Binding="{Binding IsResizeFreeInput}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:NumericSpinner.Style>
                            </controls:NumericSpinner>

                            <TextBlock Text="px 以内にする"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </WrapPanel>

                        <TextBlock Text="指定より小さい画像はそのまま"
                                   Margin="92,0,0,12"
                                   FontSize="11"
                                   Opacity="0.6" />

                        <TextBlock Text="画素値を変える" Style="{StaticResource SectionHeaderStyle}" />

                        <Grid Style="{StaticResource AdjustmentRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Content="明るさ"
                                      MinWidth="92"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.Brightness.Enabled}" />

                            <!--
                                バインディングに Delay は入れない。Delay は値が変わるたびに
                                タイマーが再スタートするため、つまみを動かし続けている間は
                                設定値が更新されず、数値表示が固まって見える。
                                プレビュー 1 枚のレンダリングは 10 ms 程度なので間引く必要はなく、
                                連続した要求は ViewModel 側が最新の 1 つに畳む。
                                測り直すには tests/Soroe.Verify の bench モード
                                （AGENTS.md「構成とビルド」参照）。
                            -->
                            <!--
                                Slider.Minimum は double。x:Static は型変換をしないため
                                int の定数をそのまま渡すと実行時に落ちる。Binding を挟むと
                                変換が効くので、範囲の定義は Model 側の 1 箇所で済ませられる。
                            -->
                            <Slider Grid.Column="1"
                                    Style="{StaticResource AdjustmentSliderStyle}"
                                    Minimum="{Binding Source={x:Static models:BrightnessOption.MinValue}, Mode=OneTime}"
                                    Maximum="{Binding Source={x:Static models:BrightnessOption.MaxValue}, Mode=OneTime}"
                                    IsEnabled="{Binding Settings.Brightness.Enabled}"
                                    Value="{Binding Settings.Brightness.Value}" />

                            <!-- スライダーでは 1 目盛りが 2px 程度になり狙えないため、詰めはこちらで -->
                            <controls:NumericSpinner Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     Minimum="{x:Static models:BrightnessOption.MinValue}"
                                                     Maximum="{x:Static models:BrightnessOption.MaxValue}"
                                                     IsEnabled="{Binding Settings.Brightness.Enabled}"
                                                     Value="{Binding Settings.Brightness.Value}" />
                        </Grid>

                        <!-- 明るさと同じ 1 本の LUT にまとめて適用される -->
                        <Grid Style="{StaticResource AdjustmentRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Content="コントラスト"
                                      MinWidth="92"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.Contrast.Enabled}" />

                            <Slider Grid.Column="1"
                                    Style="{StaticResource AdjustmentSliderStyle}"
                                    Minimum="{Binding Source={x:Static models:ContrastOption.MinValue}, Mode=OneTime}"
                                    Maximum="{Binding Source={x:Static models:ContrastOption.MaxValue}, Mode=OneTime}"
                                    IsEnabled="{Binding Settings.Contrast.Enabled}"
                                    Value="{Binding Settings.Contrast.Value}" />

                            <controls:NumericSpinner Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     Minimum="{x:Static models:ContrastOption.MinValue}"
                                                     Maximum="{x:Static models:ContrastOption.MaxValue}"
                                                     IsEnabled="{Binding Settings.Contrast.Enabled}"
                                                     Value="{Binding Settings.Contrast.Value}" />
                        </Grid>

                        <Grid Style="{StaticResource AdjustmentRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Content="彩度"
                                      MinWidth="92"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.Saturation.Enabled}" />

                            <Slider Grid.Column="1"
                                    Style="{StaticResource AdjustmentSliderStyle}"
                                    Minimum="{Binding Source={x:Static models:SaturationOption.MinValue}, Mode=OneTime}"
                                    Maximum="{Binding Source={x:Static models:SaturationOption.MaxValue}, Mode=OneTime}"
                                    IsEnabled="{Binding Settings.Saturation.Enabled}"
                                    Value="{Binding Settings.Saturation.Value}" />

                            <controls:NumericSpinner Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     Minimum="{x:Static models:SaturationOption.MinValue}"
                                                     Maximum="{x:Static models:SaturationOption.MaxValue}"
                                                     IsEnabled="{Binding Settings.Saturation.Enabled}"
                                                     Value="{Binding Settings.Saturation.Value}" />
                        </Grid>

                        <!--
                            グレースケールと二値化は UI に出していない。処理と設定モデルは
                            残してあり、適用順序（5 と 6）も番号を詰めていない。
                            外した理由は docs/decisions.md「UI から外したもの」を参照。
                        -->

                        <Grid Style="{StaticResource AdjustmentRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Content="シャープ"
                                      MinWidth="92"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.Sharpen.Enabled}" />

                            <Slider Grid.Column="1"
                                    Style="{StaticResource AdjustmentSliderStyle}"
                                    Minimum="{Binding Source={x:Static models:SharpenOption.MinValue}, Mode=OneTime}"
                                    Maximum="{Binding Source={x:Static models:SharpenOption.MaxValue}, Mode=OneTime}"
                                    IsEnabled="{Binding Settings.Sharpen.Enabled}"
                                    Value="{Binding Settings.Sharpen.Value}" />

                            <controls:NumericSpinner Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     Minimum="{x:Static models:SharpenOption.MinValue}"
                                                     Maximum="{x:Static models:SharpenOption.MaxValue}"
                                                     IsEnabled="{Binding Settings.Sharpen.Enabled}"
                                                     Value="{Binding Settings.Sharpen.Value}" />
                        </Grid>

                        <!--
                            「効いていないように見える」場面があるので断る。
                            シャープが空間フィルタであることから来る一般的な制約。
                            二値化への言及は外した。UI に出していない項目を参照しても読む人に伝わらない
                            （処理としての関係は docs/design.md に残してある）。
                        -->
                        <TextBlock Text="効き目は出力サイズに対して決まるため、縮小表示のプレビューでは分かりにくいことがあります"
                                   Margin="28,2,0,12"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="描き足す" Style="{StaticResource SectionHeaderStyle}" />

                        <Grid Style="{StaticResource AdjustmentRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Content="枠線"
                                      MinWidth="92"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.Frame.Enabled}" />

                            <Slider Grid.Column="1"
                                    Style="{StaticResource AdjustmentSliderStyle}"
                                    Minimum="{Binding Source={x:Static models:FrameOption.MinThickness}, Mode=OneTime}"
                                    Maximum="{Binding Source={x:Static models:FrameOption.MaxThickness}, Mode=OneTime}"
                                    IsEnabled="{Binding Settings.Frame.Enabled}"
                                    Value="{Binding Settings.Frame.Thickness}" />

                            <controls:NumericSpinner Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     Minimum="{x:Static models:FrameOption.MinThickness}"
                                                     Maximum="{x:Static models:FrameOption.MaxThickness}"
                                                     IsEnabled="{Binding Settings.Frame.Enabled}"
                                                     Value="{Binding Settings.Frame.Thickness}" />
                        </Grid>

                        <WrapPanel Margin="28,2,0,4">
                            <TextBlock Text="色"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />

                            <ComboBox MinWidth="120"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding FrameColorChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Color"
                                      SelectedValue="{Binding Settings.Frame.Color}"
                                      IsEnabled="{Binding Settings.Frame.Enabled}" />
                        </WrapPanel>

                        <!--
                            内側に描くことを断る。外側に足すとリサイズの指定（長辺 N）が
                            破れるので内側にしてあるが、外周が隠れること自体は目に見えるので、
                            先に書いておく。太さの上限は寸法表示の行に出る
                        -->
                        <TextBlock Text="画像の内側に描きます。外周が少し隠れますが、出力サイズは変わりません"
                                   Margin="28,2,0,4"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 書き出し -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="14,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <!--
                出力の設定はダイアログに移してある。ここは 1 行で済ませる。
                書き出しと同じ解決処理（IImageExporter.Plan）で求めているので、
                この 1 行で「どこに・どの形式で・何件」が分かる。
                長いパスでボタンが押し出されないよう、テキストを * 列に置いて省略させる。
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Text="{Binding OutputPathPreview}"
                           ToolTip="{Binding OutputPathTooltip}"
                           Opacity="0.8"
                           TextTrimming="CharacterEllipsis" />

                <!--
                    押しても即座には書き出さず、まず設定ダイアログが開く。
                    三点リーダーがその意味を表す慣習に従う。
                    進捗・結果・失敗一覧もダイアログの中に出るので、ここには何も置かない。
                -->
                <Button Grid.Column="1"
                        Content="書き出し..."
                        Padding="24,6"
                        Command="{Binding ExportCommand}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Margin="4,10,4,0"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
