<Window x:Class="Soroe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Soroe.Views.Controls"
        xmlns:converters="clr-namespace:Soroe.Views.Converters"
        xmlns:models="clr-namespace:Soroe.Models"
        xmlns:vm="clr-namespace:Soroe.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Soroe"
        Height="720"
        Width="1000"
        MinHeight="600"
        MinWidth="720"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:WidthFractionConverter x:Key="WidthFraction" />

        <!-- 調整パネルの分類見出し。3 分類で共通に使う -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- 調整項目 1 行分の並び。項目名 / スライダー / 数値入力 -->
        <Style x:Key="AdjustmentRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!--
            調整項目のスライダーに共通の振る舞い。項目が増えたらこれを適用するだけでよい。
            IsMoveToPointEnabled は、目盛りの上を押したときにその位置へつまみを飛ばす。
            既定は 1 目盛りずつの移動で、シークバーの挙動と違って戸惑うため。
            ホイールでの増減は、つまみを狙わずに 1 ずつ詰めるための補助。
        -->
        <!--
            BasedOn を必ず付けること。省略すると Fluent テーマの暗黙スタイルが
            適用されなくなり、既定のスライダーの見た目に戻ってしまう。
        -->
        <Style x:Key="AdjustmentSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <EventSetter Event="PreviewMouseWheel" Handler="OnSliderMouseWheel" />
        </Style>
    </Window.Resources>

    <!-- ウィンドウ全体でドロップを受ける。落とす場所を狙わせないほうが迷わない -->
    <Grid Margin="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 操作行 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="フォルダから追加"
                        Command="{Binding AddFolderCommand}"
                        Padding="14,6" />
                <Button Content="クリア"
                        Command="{Binding ClearCommand}"
                        Margin="8,0,0,0"
                        Padding="14,6" />
            </StackPanel>
            <TextBlock Text="{Binding Files.Count, StringFormat={}{0} 件}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- 左: ファイルリスト / 右: プレビュー -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListBox ItemsSource="{Binding Files}"
                             SelectedItem="{Binding SelectedFile}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="4"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}"
                                           ToolTip="{Binding FullPath}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="ここに画像を&#x0a;ドロップ"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Opacity="0.6"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <!-- 空のときだけ案内を出す -->
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- 上がプレビュー、下が調整パネル -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!--
                        プレビュー側に MinHeight を置かないこと。Auto 行は場所が足りなくても
                        縮まないため、MinHeight と競合すると合計が親をはみ出して下が切れる。
                        プレビューを縮ませるほうが、調整パネルが見えなくなるより分かりやすい。
                    -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               StretchDirection="DownOnly"
                               Margin="12" />

                        <TextBlock Text="プレビュー"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            プレビューは枠に合わせて表示されるため、リサイズしても見た目が
                            ほとんど変わらない。効果が分かるよう寸法を数値で示す。
                        -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding PreviewSizeText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Opacity="0.75" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="14,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <!-- 書き出し中は触らせない。開始時点の設定で処理するため、途中で変えても効かない -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- 項目が増えても縦に伸び続けないよう、上限を決めて中でスクロールさせる -->
                    <ScrollViewer MaxHeight="220"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!--
                            調整パネルは 3 分類で区切る（CLAUDE.md「調整項目」）。
                              1. キャンバスを変える … 回転、リサイズ
                              2. 画素値を変える     … 明るさ、コントラスト、彩度、
                                                      グレースケール、二値化、シャープ
                              3. 描き足す           … 枠線
                            残りの分類は、この StackPanel と同じ形（見出し + 項目行）を
                            この前後に足す。現在は 2 のうち明るさのみ実装している。
                        -->
                        <TextBlock Text="キャンバスを変える" Style="{StaticResource SectionHeaderStyle}" />

                        <!-- 窓が狭いときは折り返す。横一列に固定すると右端が切れて読めなくなる -->
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox Content="リサイズ"
                                      MinWidth="92"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.Resize.Enabled}" />

                            <TextBlock Text="長辺を"
                                       Margin="8,0,6,0"
                                       VerticalAlignment="Center" />

                            <!-- よく使う値を用途つきで並べる。自由入力もここから選ぶ -->
                            <ComboBox MinWidth="196"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding ResizePresets}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedResizePreset}"
                                      IsEnabled="{Binding Settings.Resize.Enabled}" />

                            <controls:NumericSpinner Margin="8,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Minimum="{x:Static models:ResizeOption.MinValue}"
                                                     Maximum="{x:Static models:ResizeOption.MaxValue}"
                                                     Step="10"
                                                     Value="{Binding Settings.Resize.LongestEdge}"
                                                     IsEnabled="{Binding Settings.Resize.Enabled}">
                                <controls:NumericSpinner.Style>
                                    <Style TargetType="controls:NumericSpinner">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- 自由入力を選んだときだけ出す。常に両方出すと入力先が二つに見える -->
                                            <DataTrigger Binding="{Binding IsResizeFreeInput}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:NumericSpinner.Style>
                            </controls:NumericSpinner>

                            <TextBlock Text="px 以内にする"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </WrapPanel>

                        <TextBlock Text="指定より小さい画像はそのまま"
                                   Margin="92,0,0,12"
                                   FontSize="11"
                                   Opacity="0.6" />

                        <TextBlock Text="画素値を変える" Style="{StaticResource SectionHeaderStyle}" />

                        <Grid Style="{StaticResource AdjustmentRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Content="明るさ"
                                      MinWidth="92"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.Brightness.Enabled}" />

                            <!--
                                バインディングに Delay は入れない。Delay は値が変わるたびに
                                タイマーが再スタートするため、つまみを動かし続けている間は
                                設定値が更新されず、数値表示が固まって見える。
                                プレビュー 1 枚のレンダリングは 7 ms 程度なので間引く必要はなく、
                                連続した要求は ViewModel 側が最新の 1 つに畳む。
                            -->
                            <!--
                                Slider.Minimum は double。x:Static は型変換をしないため
                                int の定数をそのまま渡すと実行時に落ちる。Binding を挟むと
                                変換が効くので、範囲の定義は Model 側の 1 箇所で済ませられる。
                            -->
                            <Slider Grid.Column="1"
                                    Style="{StaticResource AdjustmentSliderStyle}"
                                    Minimum="{Binding Source={x:Static models:BrightnessOption.MinValue}, Mode=OneTime}"
                                    Maximum="{Binding Source={x:Static models:BrightnessOption.MaxValue}, Mode=OneTime}"
                                    IsEnabled="{Binding Settings.Brightness.Enabled}"
                                    Value="{Binding Settings.Brightness.Value}" />

                            <!-- スライダーでは 1 目盛りが 2px 程度になり狙えないため、詰めはこちらで -->
                            <controls:NumericSpinner Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     Minimum="{x:Static models:BrightnessOption.MinValue}"
                                                     Maximum="{x:Static models:BrightnessOption.MaxValue}"
                                                     IsEnabled="{Binding Settings.Brightness.Enabled}"
                                                     Value="{Binding Settings.Brightness.Value}" />
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 書き出し -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="14,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <!--
                出力の設定はダイアログに移してある。ここは 1 行で済ませる。
                ResolveOutputPath が形式を反映するので、この 1 行で
                「どこに・どの形式で・何件」が分かる。
                長いパスでボタンが押し出されないよう、テキストを * 列に置いて省略させる。
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Text="{Binding OutputPathPreview}"
                           ToolTip="{Binding OutputPathTooltip}"
                           Opacity="0.8"
                           TextTrimming="CharacterEllipsis" />

                <!--
                    押しても即座には書き出さず、まず設定ダイアログが開く。
                    三点リーダーがその意味を表す慣習に従う。
                    進捗・結果・失敗一覧もダイアログの中に出るので、ここには何も置かない。
                -->
                <Button Grid.Column="1"
                        Content="書き出し..."
                        Padding="24,6"
                        Command="{Binding ExportCommand}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Margin="4,10,4,0"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
