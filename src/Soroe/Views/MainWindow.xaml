<Window x:Class="Soroe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Soroe.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Soroe"
        Height="600"
        Width="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Image 自体は中身が空だとヒットテストの対象にならず、ドロップを受け取れない。
            そのため Background を持つ Border をドロップ領域にする。
        -->
        <Border Grid.Row="0"
                AllowDrop="True"
                DragOver="OnDragOver"
                Drop="OnDrop"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       Margin="12" />

                <TextBlock Text="ここに画像をドロップ"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Opacity="0.6"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!-- 未読み込みのときだけ案内を出す -->
                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Margin="4,10,4,0"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
