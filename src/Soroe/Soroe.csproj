<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Soroe</RootNamespace>
    <AssemblyName>Soroe</AssemblyName>

    <!-- OpenCvSharp のネイティブ DLL は x64 のみ。AnyCPU にすると DllNotFoundException になる -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- ThemeMode（Fluent テーマ）は現時点では試験的 API のため、その警告のみ抑止する -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- public メンバーの XML ドキュメントコメント漏れを検知させる -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- 長いパスを許可する。詳細は app.manifest のコメントを参照 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      exe に埋め込むアイコン。Assets/icon-<辺>.svg から tools/make-icon.ps1 で
      作る。.ico を手で編集しないこと（SVG が出所）。
      WPF は Window.Icon が未指定なら exe に埋め込まれたこれを使うので、
      ウィンドウ側に個別の指定は要らない。
    -->
    <ApplicationIcon>Assets\Soroe.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    exe のプロパティに出る情報。不具合の報告を受けたときに版が分かるよう、
    Version は必ず入れておく。
    Copyright は LICENSE の表記と 1 文字違わず揃えること。食い違うと、
    どちらが正しいのか読む人に判断できない。
    Company は既定だと AssemblyName と同じ "Soroe" になり、実在しない組織のように
    見えるため、作者名を明示する。
  -->
  <PropertyGroup>
    <Version>1.0.1</Version>
    <Product>Soroe</Product>
    <Company>naganakidori</Company>
    <Authors>naganakidori</Authors>
    <Copyright>Copyright (c) 2026 naganakidori</Copyright>
    <Description>画像の一括処理に特化した Windows デスクトップアプリ</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      検証ハーネスからは internal も見えるようにする。層の分離はフォルダ分けと
      internal で守る方針だが、検証はその外側から使う相手ではなく、中を直接
      つついて確かめるためのものなので、公開範囲を広げてまで検証可能にはしない。
    -->
    <InternalsVisibleTo Include="Soroe.Verify" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
  </ItemGroup>

</Project>
