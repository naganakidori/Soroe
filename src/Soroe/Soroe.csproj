<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Soroe</RootNamespace>
    <AssemblyName>Soroe</AssemblyName>

    <!-- OpenCvSharp のネイティブ DLL は x64 のみ。AnyCPU にすると DllNotFoundException になる -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- ThemeMode（Fluent テーマ）は現時点では試験的 API のため、その警告のみ抑止する -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- public メンバーの XML ドキュメントコメント漏れを検知させる -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- 長いパスを許可する。詳細は app.manifest のコメントを参照 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!--
      検証ハーネスからは internal も見えるようにする。層の分離はフォルダ分けと
      internal で守る方針だが、検証はその外側から使う相手ではなく、中を直接
      つついて確かめるためのものなので、公開範囲を広げてまで検証可能にはしない。
    -->
    <InternalsVisibleTo Include="Soroe.Verify" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
  </ItemGroup>

</Project>
