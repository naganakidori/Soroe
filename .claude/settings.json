{
  "permissions": {
    "allow": [
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet run *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet restore *)",
      "PowerShell(dotnet add *)",
      "PowerShell(dotnet format *)",
      "PowerShell(dotnet --version)",
      "PowerShell(git *)",
      "PowerShell(cd *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Where-Object *)",
      "PowerShell(Select-String *)",
      "PowerShell(Sort-Object *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Out-String *)",
      "PowerShell(Test-Path *)"
    ],
    "ask": [
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git branch -D *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(**/*.pfx)",
      "Read(**/*.snk)"
    ]
  }
}
